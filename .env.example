# DeepSeek / AI API Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com/v1

# OpenAI API (Optional Fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Ideogram API (Optional: required for AI-generated image workflow)
IDEOGRAM_API_KEY=your_ideogram_api_key_here
IDEOGRAM_API_URL=https://api.ideogram.ai/generate
IDEOGRAM_MODEL=V_2
IDEOGRAM_MAGIC_PROMPT=AUTO

# Kokoro TTS Endpoint (Self-Hosted Docker Container)
KOKORO_TTS_URL=http://localhost:8880/v1/audio/speech
KOKORO_VOICE=af_bella
KOKORO_SPEED=0.9
# Guided meditation/relaxation cadence. Lower values speak more slowly.
KOKORO_MEDITATION_SPEED=0.72
WHISPER_ENABLED=auto
WHISPER_MAX_AUDIO_SECONDS=180
WHISPER_TIMEOUT_MS=120000
WHISPER_MODEL=Xenova/whisper-base.en

# Output Configuration
OUTPUT_FPS=30
PORT=3000

# Optional headless-client credentials for the asynchronous API. The Studio
# dashboard uses the administrator JWT session instead. Comma-separate keys
# during rotation.
VIDEO_API_KEYS=replace-with-a-long-random-api-key
# Dashboard administrator. The JWT is stored in a secure HttpOnly cookie.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password
ADMIN_OWNER_ID=acct_primary
JWT_SECRET=replace-with-an-independent-32-plus-character-random-secret
JWT_TTL_SECONDS=28800
VIDEO_API_MAX_REQUEST_BYTES=1mb
VIDEO_WORKER_CONCURRENCY=1
VIDEO_QUEUE_GLOBAL_CONCURRENCY=1
# Admission control protects CPU, memory, provider quotas, and local disk.
VIDEO_MAX_QUEUED_JOBS=25
VIDEO_MAX_OWNER_PENDING_JOBS=5
VIDEO_MAX_CHANNEL_PENDING_JOBS=2
VIDEO_ESTIMATED_JOB_MINUTES=20
AI_IMAGE_ESTIMATED_COST_USD=0.003
LLM_ESTIMATED_COST_PER_VIDEO_USD=0.02
# Grace period before active renders are interrupted and recovered on restart.
VIDEO_SHUTDOWN_TIMEOUT_MS=30000
VIDEO_AUTOMATIC_RETRY_LIMIT=2
VIDEO_WORKER_STOP_GRACE_PERIOD=2m
# Bound provider downloads and pixel inspections per unresolved shot.
ASSET_PRIMARY_MATERIALIZATION_ATTEMPTS=6
ASSET_EMERGENCY_MATERIALIZATION_ATTEMPTS=3

# Optional YouTube OAuth/autopublishing. Generate both secrets independently
# with at least 32 random characters. The redirect must end in
# /oauth/youtube/callback and exactly match Google Cloud Console.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/oauth/youtube/callback
YOUTUBE_OAUTH_STATE_SECRET=
YOUTUBE_TOKEN_ENCRYPTION_KEY=
YOUTUBE_UPLOAD_TIMEOUT_MS=3600000
YOUTUBE_ANALYTICS_ENABLED=true
YOUTUBE_PUBLISHING_ENABLED=false
