# DeepSeek / AI API Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com/v1

# OpenAI API (Optional Fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Kokoro TTS Endpoint (Self-Hosted Docker Container)
KOKORO_TTS_URL=http://localhost:8880/v1/audio/speech
KOKORO_VOICE=af_bella
KOKORO_SPEED=0.9
# Guided meditation/relaxation cadence. Lower values speak more slowly.
KOKORO_MEDITATION_SPEED=0.72

# Output Configuration
OUTPUT_FPS=30
PORT=3000

# Application-facing asynchronous API. Comma-separate keys during rotation.
# Required when NODE_ENV=production.
VIDEO_API_KEYS=replace-with-a-long-random-api-key
VIDEO_API_MAX_REQUEST_BYTES=1mb
VIDEO_WORKER_CONCURRENCY=1
# Admission control protects CPU, memory, provider quotas, and local disk.
VIDEO_MAX_QUEUED_JOBS=25
VIDEO_MAX_OWNER_PENDING_JOBS=5
# Grace period before active renders are interrupted and recovered on restart.
VIDEO_SHUTDOWN_TIMEOUT_MS=30000
