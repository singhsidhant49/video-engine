# Copy this file to .env and replace every placeholder before deployment.
VIDEO_API_KEYS=replace-with-a-long-random-api-key
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_API_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

VIDEO_API_PORT=3000
VIDEO_API_BIND_IP=0.0.0.0
VIDEO_WORKER_CONCURRENCY=1
VIDEO_QUEUE_LOCK_MS=600000
VIDEO_QUEUE_LOCK_RENEW_MS=30000
VIDEO_QUEUE_STALLED_INTERVAL_MS=60000
VIDEO_QUEUE_MAX_STALLED_COUNT=2
REMOTION_CONCURRENCY=2
VIDEO_MOTION_PRESET=standard
VIDEO_MAX_QUEUED_JOBS=25
VIDEO_MAX_OWNER_PENDING_JOBS=5
VIDEO_SHUTDOWN_TIMEOUT_MS=30000
VIDEO_API_MAX_REQUEST_BYTES=1mb

KOKORO_VOICE=af_bella
KOKORO_SPEED=0.9
KOKORO_MEDITATION_SPEED=0.72
# Safe default. Use this host's private-LAN IP only for trusted LAN clients.
KOKORO_BIND_IP=127.0.0.1
