# Copy this file to .env and replace every placeholder before deployment.
# Optional named credentials preserve headless-client ownership across key
# rotation. The browser dashboard uses its administrator JWT session.
VIDEO_API_KEYS=client-name:replace-with-a-long-random-api-key
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password
# Match the named API account when retaining existing owner-scoped data.
ADMIN_OWNER_ID=acct_client-name
JWT_SECRET=replace-with-an-independent-32-plus-character-random-secret
JWT_TTL_SECONDS=28800
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
# Pin an explicitly reviewed Kokoro image by digest, never a mutable tag.
KOKORO_IMAGE=ghcr.io/remsky/kokoro-fastapi-cpu@sha256:replace-with-approved-digest

DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_API_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

VIDEO_API_PORT=3000
VIDEO_API_BIND_IP=127.0.0.1
VIDEO_WORKER_CONCURRENCY=1
# Enforced by Redis across all worker replicas. Keep at 1 on CPU-only VPS hosts.
VIDEO_QUEUE_GLOBAL_CONCURRENCY=1
VIDEO_QUEUE_LOCK_MS=600000
VIDEO_QUEUE_LOCK_RENEW_MS=30000
VIDEO_QUEUE_STALLED_INTERVAL_MS=60000
VIDEO_QUEUE_MAX_STALLED_COUNT=2
REMOTION_CONCURRENCY=2
VIDEO_MOTION_PRESET=standard
CACHE_RETENTION_DAYS=14
VIDEO_MAX_QUEUED_JOBS=25
VIDEO_MAX_OWNER_PENDING_JOBS=5
VIDEO_SHUTDOWN_TIMEOUT_MS=30000
VIDEO_WORKER_STOP_GRACE_PERIOD=2m
VIDEO_JOB_TIMEOUT_MS=5400000
# Bound provider downloads and pixel inspections per unresolved shot.
ASSET_PRIMARY_MATERIALIZATION_ATTEMPTS=6
ASSET_EMERGENCY_MATERIALIZATION_ATTEMPTS=3
VIDEO_API_MAX_REQUEST_BYTES=1mb
VIDEO_API_RATE_LIMIT_PER_MINUTE=120
# Keep false for multi-client/confidential production. Enabling shares hashed
# script, narration and search cache entries across jobs on this deployment.
VIDEO_SHARED_SENSITIVE_CACHE=false

# Optional YouTube Data API v3 OAuth. For production, use the public HTTPS
# callback URL registered in Google Cloud Console.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://video.example.com/oauth/youtube/callback
YOUTUBE_OAUTH_STATE_SECRET=replace-with-an-independent-32-plus-character-random-secret
YOUTUBE_TOKEN_ENCRYPTION_KEY=replace-with-another-32-plus-character-random-secret
YOUTUBE_UPLOAD_TIMEOUT_MS=3600000
YOUTUBE_ANALYTICS_ENABLED=true
YOUTUBE_PUBLISHING_ENABLED=false

KOKORO_VOICE=af_bella
KOKORO_SPEED=0.9
KOKORO_MEDITATION_SPEED=0.72
# CPU-safe speech alignment. Set max seconds to 0 only on a machine that can
# handle unbounded local Whisper workloads. Timeouts hard-kill the isolated
# Whisper child process and fall back to deterministic word timing.
WHISPER_ENABLED=auto
WHISPER_MAX_AUDIO_SECONDS=180
WHISPER_TIMEOUT_MS=120000
WHISPER_MODEL=Xenova/whisper-base.en
# Safe default. Use this host's private-LAN IP only for trusted LAN clients.
KOKORO_BIND_IP=127.0.0.1
